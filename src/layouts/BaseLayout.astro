---
import "../styles/global.css";
import "../styles/scene-stability.css";
import "../styles/nav-dock.css";

const {
  title = "Ayaan Retiwala · Platform Engineer",
  description = "Ayaan Retiwala builds cloud infrastructure: compute, storage, Kubernetes, networking, identity, and the systems around them.",
  ambient = false,
  // Set by the private draft previews under /admin. They are behind Cloudflare
  // Access and can never be crawled, but a page that is not for the public also
  // has no business claiming a canonical url or being counted in analytics.
  noindex = false
} = Astro.props;

const SITE = "https://lolwierd.com";
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL("/og.jpg", SITE).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Kept in step with the sky phase by the inline script below, since the
         page's own light/dark no longer tracks prefers-color-scheme. -->
    <meta name="theme-color" content="#eee9df" />
    <meta name="description" content={description} />
    <meta name="author" content="Ayaan Retiwala" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ayaan Retiwala — i build systems from the machine up." />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ayaan Retiwala · writing"
      href="/rss.xml"
    />
    <title>{title}</title>
    <script is:inline>
      // Day or night is decided by the sun over Vadodara, not by the visitor's OS
      // theme -- the whole scene is a real view of one place at the current hour.
      // This has to run before first paint, so it carries its own compact solar
      // position calc rather than waiting for the suncalc bundle. It agrees with
      // suncalc to within half a degree; sky-v3 overwrites it with the exact value
      // once loaded, and again every minute.
      (function () {
        var LAT = 22.3072;
        var LON = 73.1812;
        try {
          var rad = Math.PI / 180;
          var d = Date.now() / 86400000 - 10957.5;
          var g = (357.529 + 0.98560028 * d) * rad;
          var q = 280.459 + 0.98564736 * d;
          var L = (q + 1.915 * Math.sin(g) + 0.02 * Math.sin(2 * g)) * rad;
          var e = (23.439 - 0.00000036 * d) * rad;
          var dec = Math.asin(Math.sin(e) * Math.sin(L));
          var ra = Math.atan2(Math.cos(e) * Math.sin(L), Math.cos(L));
          var lst = (((18.697374558 + 24.06570982441908 * d) % 24) * 15 + LON) * rad;
          var la = LAT * rad;
          var alt = Math.asin(
            Math.sin(la) * Math.sin(dec) + Math.cos(la) * Math.cos(dec) * Math.cos(lst - ra)
          ) / rad;
          var night = alt <= -6;
          document.documentElement.dataset.sky = night ? "night" : "day";
          var themeColor = document.querySelector('meta[name="theme-color"]');
          if (themeColor) themeColor.setAttribute("content", night ? "#0b0e13" : "#eee9df");
        } catch (error) {
          // Leave the attribute off: the stylesheet then falls back to the OS theme.
        }
      })();

      window.__isNight = function () {
        return document.documentElement.dataset.sky === "night";
      };

      // Whether this browser has ever opened the editor. It reveals an "edit"
      // link that is already in the html, and nothing else -- the link goes to
      // /admin, which Cloudflare Access guards, so forging this shows you a link
      // to a page you cannot open. Read before first paint so the link does not
      // arrive late and shove the meta line sideways.
      // On localhost the links are always shown — drafts are already rendered in
      // dev and you are the owner there.
      try {
        const host = window.location.hostname;
        const isLocal = host === "localhost" || host === "127.0.0.1" || host === "::1" || host.endsWith(".local");
        if (isLocal || localStorage.getItem("lolwierd.editor") === "1") {
          document.documentElement.dataset.owner = "";
        }
      } catch (error) {
        // No storage: no link, and the page is correct without it.
      }
    </script>
    {ambient && (
      <script is:inline>
        // Hold the hero entrance until hero-clearance.js has placed the copy clear
        // of the ridge, so that correction never reads as a layout shift. Releases
        // itself if the measurement never arrives, and is inert without JS.
        document.documentElement.setAttribute("data-hero-hold", "");
        document.documentElement.setAttribute("data-ambient", "");
        setTimeout(function () {
          document.documentElement.removeAttribute("data-hero-hold");
        }, 1200);
      </script>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/DepartureMono-Regular.woff2"
      crossorigin
    />
    {ambient && (
      <link
        rel="preload"
        as="image"
        href="/assets/annapurna-circuit.jpg"
        fetchpriority="high"
      />
    )}
    {!noindex && (
      <script is:inline type="text/javascript">
        (function (c, l, a, r, i, t, y) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          t = l.createElement(r);
          t.async = 1;
          t.src = "https://www.clarity.ms/tag/" + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", "jcg9gkbk3q");
      </script>
    )}
  </head>
  <body>
    {ambient && (
      <div id="sky-stage" aria-hidden="true">
        <canvas id="sky"></canvas>
      </div>
    )}
    <slot />
    <!-- The way in to /admin: press and hold the site name (800ms). A convenience
         only -- Cloudflare Access is the boundary. See the script for why. -->
    <script>
      import "../scripts/admin-door.js";
    </script>
    {ambient && (
      <script>
        import "../scripts/scene-stability.js";
        import "../scripts/sky-v3.js";
        import "../scripts/sky-life-boost.js";
        import "../scripts/day-atmosphere.js";
        import "../scripts/twilight-sky.js";
        import "../scripts/night-sky-v2.js";
        import "../scripts/comet-cadence.js";
        import "../scripts/hero-clearance.js";
        import "../scripts/sky-focus.js";
        import "../scripts/sky-readout.js";
        import "../scripts/easter-eggs.js";
      </script>
    )}
  </body>
</html>
