---
import BaseLayout from "./BaseLayout.astro";
import "../styles/interior.css";

// The shell every page that is not the front page uses, and it is the front
// page's own shell: the live scene in the first viewport, then an opaque
// reading ground under it. There is one sky over this site, so every page that
// shows sky shows that one -- the same canvas, the same scripts, the same hour
// over Vadodara -- rather than a still of it printed at the foot.
//
// The `hero` slot is what sits over the scene (a title, and whatever belongs
// beside it); the default slot is everything that has to be read, which lands
// on paper below.
const { title, description } = Astro.props;
---

<BaseLayout ambient title={title} description={description}>
  <header class="hero" id="top">
    <div class="hero-frame">
      <div class="topbar">
        <!-- Just the name here. The front page's masthead introduces him, which
             is what a front page is for; repeating the job title at the top of
             every post is a signature on someone else's letter. -->
        <p class="site-name">
          <a href="/">ayaan retiwala</a>
        </p>
        <nav class="hero-nav" data-nav-dock aria-label="Site">
          <a href="/#work">work</a>
          <a href="/#projects">projects</a>
          <a href="/writing/">writing</a>
          <a href="/#contact">contact</a>
        </nav>
      </div>

      <div class="hero-copy">
        <slot name="hero" />
      </div>
    </div>
  </header>

  <main class="reading-ground">
    <div class="reading-inner">
      <slot />
    </div>
  </main>
</BaseLayout>
