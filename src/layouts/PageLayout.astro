---
import BaseLayout from "./BaseLayout.astro";
import "../styles/interior.css";

// The shell for every page that is not the front page.
//
// No scene, and no hero holding one. The front page and the 404 have nothing to
// read, so a viewport of sky is the point there; these pages exist to be read,
// and a full screen of mountain in front of the writing just means the writing
// does not get read. They also skip the 1.8MB plate and the sky scripts, which
// is the right trade for a page of prose.
const { title, description, noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="page">
    <div class="page-frame">
      <div class="topbar">
        <!-- Just the name here. The front page's masthead introduces him, which
             is what a front page is for; repeating the job title at the top of
             every post is a signature on someone else's letter. -->
        <p class="site-name">
          <a href="/">ayaan retiwala</a>
        </p>
        <nav class="hero-nav" aria-label="Site">
          <a href="/#work">work</a>
          <a href="/#projects">projects</a>
          <a href="/writing/">writing</a>
          <a href="/#contact">contact</a>
        </nav>
      </div>

      <main class="page-body">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>
