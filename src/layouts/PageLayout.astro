---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/interior.css";

// The shell for every page that is not the front page.
//
// No scene, and no hero holding one. The front page and the 404 have nothing to
// read, so a viewport of sky is the point there; these pages exist to be read,
// and a full screen of mountain in front of the writing just means the writing
// does not get read. They also skip the 1.8MB plate and the sky scripts, which
// is the right trade for a page of prose.
const { title, description, noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="page">
    <div class="page-frame">
      <SiteHeader />

      <main class="page-body">
        <slot />
      </main>

      <SiteFooter />
    </div>
  </div>
</BaseLayout>
