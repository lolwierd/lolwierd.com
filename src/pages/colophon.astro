---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Colophon · Ayaan Retiwala">
  <main class="colophon">
    <a href="/">← back</a>
    <h1>colophon</h1>
    <p>
      the mountain photograph is by Alexis Rodriguez, captured at Annapurna I
      in Nepal. it is used from
      <a href="https://unsplash.com/photos/a-mountain-range-with-snow-covered-mountains-in-the-background-8eo8PsNIrNs">Unsplash</a>
      under the
      <a href="https://unsplash.com/license">Unsplash License</a>.
    </p>
  </main>

  <style>
    .colophon {
      max-width: 42rem;
      min-height: 100svh;
      margin: 0 auto;
      padding: 12vh 1.25rem 4rem;
    }

    .colophon h1 {
      max-width: none;
      margin: 1rem 0 2rem;
      font: 400 clamp(2.7rem, 7vw, 5.5rem) / 0.95 var(--serif);
      letter-spacing: -0.05em;
    }

    .colophon p {
      max-width: 35rem;
      color: var(--ink-dim);
    }

    .colophon a {
      font-family: var(--mono);
      font-size: 0.78rem;
    }
  </style>
</BaseLayout>
