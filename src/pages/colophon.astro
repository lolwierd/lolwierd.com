---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Colophon · Ayaan Retiwala">
  <main class="colophon">
    <a class="back" href="/">← back</a>
    <p class="label">colophon</p>
    <p class="note">
      the mountain photograph is by Alexis Rodriguez, captured at Annapurna I
      in Nepal. it is used from
      <a href="https://unsplash.com/photos/a-mountain-range-with-snow-covered-mountains-in-the-background-8eo8PsNIrNs">Unsplash</a>
      under the
      <a href="https://unsplash.com/license">Unsplash License</a>.
    </p>
  </main>

  <style>
    .colophon {
      width: min(100%, 44rem);
      min-height: 100svh;
      margin: 0 auto;
      padding: clamp(2rem, 6vw, 5rem) 1.25rem 4rem;
    }

    .back,
    .label {
      font-family: var(--mono);
      font-size: 0.64rem;
    }

    .back {
      color: var(--ink-dim);
      text-decoration: none;
    }

    .label {
      margin: clamp(6rem, 18vh, 10rem) 0 1.5rem;
      color: var(--accent);
      letter-spacing: 0.06em;
    }

    .note {
      max-width: 34rem;
      margin: 0;
      color: var(--ink-dim);
      font: 400 clamp(1.15rem, 2.2vw, 1.45rem) / 1.65 var(--serif);
      letter-spacing: -0.012em;
    }
  </style>
</BaseLayout>
